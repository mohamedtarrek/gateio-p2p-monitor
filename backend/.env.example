# Gate.io P2P Monitor Configuration
# Copy this to .env and fill in your values

# Telegram Bot Configuration (Get from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Default Monitor Settings (can be updated via UI)
DEFAULT_TRADER_NAME=your_gateio_trader_name
DEFAULT_MIN_QUANTITY=100

# Polling interval in seconds (minimum 5)
POLLING_INTERVAL=10

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Environment
ENVIRONMENT=production
LOG_LEVEL=INFO
